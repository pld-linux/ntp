From 7ff249015e94bd761b81f6a4efcb98358a239c74 Mon Sep 17 00:00:00 2001
From: Dave Hart <hart@ntp.org>
Date: Wed, 24 Jul 2024 01:29:44 +0000
Subject: [PATCH] [Bug 3928] ntpd 4.2.8p18 crash when bringing up net interface
 fails.

bk: 66a05908VAEUbPES33k8_ZsJoNaQDw
---
 ntpd/ntp_io.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/ntpd/ntp_io.c b/ntpd/ntp_io.c
index 9d79fe493d..c9b1822763 100644
--- a/ntpd/ntp_io.c
+++ b/ntpd/ntp_io.c
@@ -1917,15 +1917,14 @@ update_interfaces(
 			}
 			new_interface_found = TRUE;
 			DPRINT_INTERFACE(3,
-				(ep, "updating ", " new - created\n"));
-		}
-		else {
+				(ep2, "updating ", " new - created\n"));
+		} else {
 			DPRINT_INTERFACE(3,
-				(ep, "updating ", " new - FAILED"));
+				(ep2, "updating ", " new - FAILED"));
 
 			msyslog(LOG_ERR,
 				"cannot bind address %s",
-				stoa(&ep->sin));
+				stoa(&ep2->sin));
 		}
 		free(ep2);
 	}
